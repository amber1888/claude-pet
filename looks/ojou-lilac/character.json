      "完成了呢～",
      "太好了～",
      "辛苦啦，来杯红茶吧～"
    ],
    "proud": [
      "呵呵……做得很漂亮呢～",
      "这么多事情都做完了哦～"
    ],
    "oops": [
      "哎呀……",
      "出错了呢……别担心，我再试试。",
      "呜……红茶洒了……"
    ],
    "sorry": [
      "对不起……是我弄错了。",
      "你说得对，我马上改～"
    ],
    "surprised": [
      "呀！",
      "吓了我一跳呢……"
    ],
    "pat": [
      "呵呵……好痒～",
      "被摸头了……（开心）",
      "再一下……就一下哦。"
